# ═══════════════════════════════════════════════════════════════════════════════
# Amata Properties — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env.local and fill in your values.
#   cp .env.example .env.local
#
# IMPORTANT: Never commit .env.local or any file containing real secrets.
#
# Legend:
#   [MANDATORY] — required for the application to start or function
#   [OPTIONAL]  — safe to leave empty; feature will be disabled
# ═══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────

# Public-facing application name (used in page titles, headers, emails)
NEXT_PUBLIC_APP_NAME=Amata Properties

# Full public URL (no trailing slash) — used for canonical URLs, sitemap, emails
# [MANDATORY]
NEXT_PUBLIC_APP_URL=https://amataproperties.com

# ── Database ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string
# [MANDATORY]
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=

# ── Authentication ────────────────────────────────────────────────────────────

# Secret used for JWT/HMAC signing of session tokens.
# Generate with: openssl rand -hex 32
# [MANDATORY]
AUTH_SECRET=

# Better Auth URL (must match the deployed domain)
# [MANDATORY]
BETTER_AUTH_URL=

# Public-facing Better Auth URL (for client-side use)
# [MANDATORY if using client components that reference auth]
NEXT_PUBLIC_BETTER_AUTH_URL=

# Session cookie name (optional — defaults to "amata_session")
SESSION_COOKIE_NAME=

# ── Resend (Transactional Email) ──────────────────────────────────────────────

# Resend API key — get one at https://resend.com
# Without this, email sending will be disabled (notifications still logged to DB)
# [MANDATORY for email]
RESEND_API_KEY=

# From: email address (must be verified in Resend)
# [MANDATORY if RESEND_API_KEY is set]
EMAIL_FROM=notifications@amataproperties.com

# From: display name
# [OPTIONAL — defaults to "Amata Properties"]
EMAIL_FROM_NAME=

# Reply-to address for transactional emails
# [OPTIONAL]
EMAIL_REPLY_TO=sales@amataproperties.com

# ── File Storage (S3-compatible — Cloudflare R2 / AWS S3 / MinIO) ─────────────

# S3 endpoint URL
# [OPTIONAL — feature disabled if empty]
S3_ENDPOINT=

# S3 access key
# [OPTIONAL]
S3_ACCESS_KEY_ID=

# S3 secret key
# [OPTIONAL]
S3_SECRET_ACCESS_KEY=

# S3 bucket name
# [OPTIONAL]
S3_BUCKET_NAME=

# Public-facing S3 URL (e.g. R2.dev subdomain or custom domain)
# [OPTIONAL]
S3_PUBLIC_URL=

# S3 region (default: "auto" for Cloudflare R2)
# [OPTIONAL — defaults to "auto"]
S3_REGION=auto

# UploadThing token (alternative storage provider)
# [OPTIONAL]
UPLOADTHING_TOKEN=

# ── Payment Gateway (Velocity) ────────────────────────────────────────────────

# Velocity Payments API URL
# [OPTIONAL — feature disabled if empty]
VELOCITY_API_URL=

# Velocity Payments API key
# [OPTIONAL]
VELOCITY_API_KEY=

# ── Maps ──────────────────────────────────────────────────────────────────────

# Mapbox public token (for interactive stand maps)
# [OPTIONAL — maps use OpenStreetMap fallback if empty]
NEXT_PUBLIC_MAPBOX_TOKEN=

# Google Maps API key (for location features)
# [OPTIONAL]
GOOGLE_MAPS_API_KEY=

# ── Analytics ─────────────────────────────────────────────────────────────────

# Google Analytics Measurement ID
# [OPTIONAL]
NEXT_PUBLIC_GA_ID=

# ── Cron / Background Jobs ────────────────────────────────────────────────────

# Secret for authenticating cron webhook requests
# Generate with: openssl rand -hex 32
# [MANDATORY if using cron endpoints]
CRON_SECRET=

# ── Development Convenience ───────────────────────────────────────────────────

# Demo mode — enables demo users in non-production environments
# [OPTIONAL — set to "true" for local development without a database]
DEMO_MODE=true
